# Minecraft-Spiel-Einstellungen (Defaults)
# Nach Änderungen:  docker compose up -d
#
# Hardcore gilt vollständig nur für eine neue Welt.
# Wenn schon eine Welt in data/ liegt: Server stoppen, data/world löschen, dann neu starten.

HARDCORE=true
DIFFICULTY=hard
MODE=survival
MOTD=Paper 26.2 Hardcore
MAX_PLAYERS=20
VIEW_DISTANCE=32
SIMULATION_DISTANCE=32
SPAWN_PROTECTION=0
ONLINE_MODE=true
PVP=true
ENABLE_COMMAND_BLOCK=true
ALLOW_NETHER=true
ALLOW_FLIGHT=false
